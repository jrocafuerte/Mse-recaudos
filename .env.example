# Copiar a .env SOLO en desarrollo local. En QA/producción se inyecta desde el gestor de secretos.
NODE_ENV=development
PORT=3001
AUDIENCE=mse-recaudos
TRUSTED_ISSUER=https://api.banco.example/mse-banca-movil
TRUSTED_JWKS_URL=http://localhost:3000/.well-known/jwks.json
SESSION_TTL_SECONDS=600
# Origen público del micro frontend (validación de Origin anti-CSRF)
ALLOWED_ORIGINS=http://localhost:3002
# Secreto compartido con el servidor Next (≥ 32 caracteres, obligatorio en producción)
INTERNAL_CLIENT_SECRET=
